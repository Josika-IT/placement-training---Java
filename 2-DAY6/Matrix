import java.util.*;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int R = sc.nextInt();
		int C = sc.nextInt(), row, col;
		int mat[][] = new int[R][C];
		for(row=0;row<R;row++)
		    for(col=0;col<C;col++)
		        mat[row][col] = sc.nextInt();
		for(row=0;row<R;row++) {
		    int max = mat[row][0];
		    for(col=0;col<C;col++) {
		        if(max < mat[row][col])
		            max = mat[row][col];
		    }
		    System.out.print(max + " ");
		}
	}
}
