import java.util.*;

public class Main {
	public static void main(String[] args) {
		List<Integer> arr = new ArrayList<>();
		arr.add(10);
		arr.add(20);
		arr.add(30);
		arr.add(40);
		arr.add(50);
		Iterator<Integer> itr = arr.iterator();
		while(itr.hasNext()) {
		    if(itr.next() == 30)
		        itr.remove();
		}
		System.out.print(arr);
	}
}
