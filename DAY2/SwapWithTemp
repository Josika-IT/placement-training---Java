import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int a = sc.nextInt();
      int b = sc.nextInt();
      System.out.println("Swapping of value of 2 variables");
      int temp = a;
      int a = b;
      int b = temp;
      System.out.println(a);
      System.out.println(b);
}
